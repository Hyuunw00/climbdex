{
  "expo": {
    "name": "climbdex",
    "slug": "climbdex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.climbdex.app",
      "supportsTablet": false,
      "appleTeamId": "UZTXXV5UD5",
      "infoPlist": {
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.climbdex.app.detect.*"
        ]
      }
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "자를 등반 영상을 고르기 위해 사진 앱 접근이 필요해요.",
          "cameraPermission": "암장 도감 사진을 찍기 위해 카메라가 필요해요."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "자른 클립을 사진 앱에 저장하기 위해 필요해요.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "근처 암장을 찾아 도감에 등록하기 위해 위치가 필요해요."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "android": {
      "package": "com.climbdex.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1
    },
    "scheme": "climbdex"
  }
}
